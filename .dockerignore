.cache/
build/
docs/
.git/
**/__pycache__/
.venv/
# Never let local secrets or Terraform state into an image layer: the build
# context is the repo root, and anything sent there can end up in a COPY.
**/*.tfvars
**/*.tfstate
**/*.tfstate.backup
**/.terraform/
graphify-out/
# Run outputs (evidence manifests and their gitignored raw/ data, e.g. 12 GB sim
# bags) never belong in an image, and must not bloat the build context.
evaluation/runs/
