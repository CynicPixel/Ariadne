<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="kprobe">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    @PHYSICS@
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="KinematicProbe" name="KinematicProbe"><model_name>rig</model_name></plugin>
    <scene><ambient>0 0 0 1</ambient><background>0 0 0 1</background><grid>false</grid></scene>
    <model name="wall"><static>true</static><pose>8.05 0 1 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.1 60 6</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="rig">
      <static>@STATIC@</static>
      <pose>0 0 1 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial><mass>1.0</mass></inertial>
        <light type="spot" name="lamp">
          <pose>0 0 0 0 0 0</pose>
          <diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
          <attenuation><range>30</range><constant>0.2</constant><linear>0.0</linear><quadratic>0.02</quadratic></attenuation>
          <direction>1 0 0</direction>
          <spot><inner_angle>0.2</inner_angle><outer_angle>0.3</outer_angle><falloff>1.0</falloff></spot>
          <cast_shadows>false</cast_shadows>
        </light>
        <sensor name="cam" type="camera">
          <camera><horizontal_fov>1.5708</horizontal_fov>
            <image><width>320</width><height>180</height><format>L8</format></image>
            <clip><near>0.05</near><far>50</far></clip></camera>
          <always_on>1</always_on><update_rate>20</update_rate><topic>probe/cam</topic>
        </sensor>
        <sensor name="depth" type="depth_camera">
          <camera><horizontal_fov>1.5708</horizontal_fov>
            <image><width>320</width><height>180</height><format>R_FLOAT32</format></image>
            <clip><near>0.05</near><far>50</far></clip></camera>
          <always_on>1</always_on><update_rate>20</update_rate><topic>probe/depth</topic>
        </sensor>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate><topic>probe/imu</topic></sensor>
      </link>
    </model>
  </world>
</sdf>
