// Ariadne wire schema (arch §4.1-4.4, §15.2, §15.5, §15.7).
//
// This file is the SINGLE definition of what crosses the network. Generated
// headers are produced by flatc at build time and are never committed, so the
// schema cannot drift from the code that uses it.
//
// Sizing intent from §15.7, which the byte-accounting tests assert against:
//   Pose            7 x f32                      = 28 B
//   SE(3) pose edge 7 x f32 + 21 x f32 + ids     ~ 150 B
//   Pose-graph node                              ~ 28 B

namespace ariadne.wire;

/// §4.4. Values are pinned: the wire format depends on them, so reordering
/// this enum is a breaking protocol change.
enum MessageClass : ubyte {
  HEARTBEAT = 0,
  GLOBAL_DESCRIPTOR = 1,
  LOCAL_DESCRIPTOR = 2,
  MATCH_REQUEST = 3,
  MATCH_RESPONSE = 4,
  POSE_EDGE = 5,
  POSE_GRAPH = 6,
  SUBMAP_SUMMARY = 7,
  SUBMAP_PATCH = 8,
  TASK_BID = 9,
  TASK_CONSENSUS = 10,
  HUMAN_REQUEST = 11,
  ACK = 12
}

enum EdgeStatus : ubyte {
  CANDIDATE = 0,
  GEOMETRY_VERIFIED = 1,
  DEGENERATE = 2,
  PCM_REJECTED = 3,
  GNC_INLIER = 4,
  GNC_OUTLIER = 5,
  /// Appended (3.2): an intra-agent odometry edge inside a POSE_GRAPH snapshot.
  ODOMETRY = 6
}

struct Quaternion { w:float; x:float; y:float; z:float; }
struct Translation { x:float; y:float; z:float; }

/// SE(3) only. C2: a wire schema cannot contain "Sim3 or SE3"; stereo makes
/// scale observable per agent, so inter-agent edges are SE(3). Sim(3) exists
/// only in the monocular ablation and in offline Umeyama alignment, neither of
/// which crosses this serializer.
struct Pose { q:Quaternion; t:Translation; }

/// §15.5 reference-frame algebra. Every pose is frame-tagged and the
/// deserializer REJECTS untagged poses, because a pose whose frame is unknown
/// cannot be composed with anything.
struct FrameTag { agent:uint; epoch:uint; }

/// COLLAB_3.2 §4: a broker solve's identity. `counter` = 1 + max over the
/// members' last accepted counters, so a merge is newer than both sides; the
/// full triple (not the counter alone) identifies an estimate.
struct Epoch { counter:ulong; members_hash:ulong; broker:uint; }

/// COLLAB_3.2 §3.2: transport acks name transport message ids. `done` lists
/// messages completed (or re-received whole) since the receiver's last ack;
/// `partial` carries a fragment bitmap (bit i = fragment i received) for a
/// message still being reassembled, so only missing fragments are resent.
table PartialAck { msg_id:uint; received:[ubyte]; }
table Ack { done:[uint]; partial:[PartialAck]; }

/// T_G_W for one agent in a broker estimate: G is the estimate's frame
/// (PoseGraph.anchor), W the agent's odometry frame.
table AgentFrame { agent:uint; T_G_W:Pose; }

table PoseNode {
  agent:uint;
  keyframe:ulong;
  stamp_ns:long;
  pose:Pose;
  frame:FrameTag;
}

/// §4.3.
table LoopEdge {
  agent_a:uint;
  keyframe_a:ulong;
  agent_b:uint;
  keyframe_b:ulong;
  measurement:Pose;
  /// Upper triangle of the 6x6 information matrix, row-major: 21 floats.
  information:[float];
  frame_a:FrameTag;
  frame_b:FrameTag;
  status:EdgeStatus;
  inlier_count:uint;
  retrieval_score:float;
  pcm_score:float;
  gnc_weight:float;
  degeneracy_flag:bool;
}

table PoseGraph {
  nodes:[PoseNode];
  edges:[LoopEdge];
  anchor:FrameTag;
  // Appended (3.2): set only on a broker estimate.
  epoch:Epoch;
  agent_frames:[AgentFrame];
}

table Heartbeat {
  agent:uint;
  stamp_ns:long;
  pose:Pose;
  frame:FrameTag;
  battery:float;
  link_state:float;
  keyframe_watermark:ulong;
  // Appended (3.2, COLLAB_3.2 §4).
  neighbors:[uint];
  anchor:uint;
  broker:uint;
  epoch:Epoch;
  ack:Ack;
}

/// Every message on the wire is an Envelope. One root type means one
/// serialization boundary, which is what makes byte accounting honest.
/// §15.2 global descriptor (1.6 placeholder: mean-pooled ORB bits, 256 floats).
table GlobalDescriptor {
  keyframe_id:ulong;
  stamp_ns:long;
  descriptor:[float];
  quality:float;
  // 3.4 (D170), appended: the size of this keyframe's feature response, so the broker can price a request before
  // sending it. 0 = not advertised (Phase 1 / v1 senders; FlatBuffers omits default-valued fields, so v1 bytes are
  // unchanged).
  n_features:uint;
  feature_bytes:ushort;   // descriptor bytes per feature (ORB 32)
  // D171, appended: the descriptor as IEEE fp16 bits (arch §15.7's encoding); then `descriptor` is absent. v1 senders
  // never set it, so their bytes are unchanged.
  descriptor_f16:[ushort];
}

/// §15.2 candidate request: the broker asks for one keyframe's local features.
table MatchRequest {
  request_id:ulong;
  query_keyframe:ulong;       // the requester's keyframe
  candidate_keyframe:ulong;   // the receiver's keyframe whose features are wanted
  feature_type:ubyte;         // 0 = ORB-256
}

/// §15.2 feature response: keypoints (x,y pairs), descriptors (32 B each), the
/// sender's 3D points in its rectified-left camera frame (x,y,z triples, NaN =
/// no depth), and camera metadata (fx, fy, cx, cy, baseline_m).
table FeatureResponse {
  request_id:ulong;
  keyframe_id:ulong;
  keypoints:[float];
  descriptors:[ubyte];
  points3d:[float];
  camera:[float];
  // D171, appended: descriptor bytes per feature (0 = ORB's 32, the v1 layout) and a per-response header before them
  // (the int8 encoding's 4-byte scale). v1 senders never set them, so their bytes are unchanged.
  feature_bytes:ushort;
  header_bytes:ushort;
}

table Envelope {
  cls:MessageClass;
  sender:uint;
  receiver:uint;
  stamp_ns:long;
  sequence:ulong;
  heartbeat:Heartbeat;
  pose_graph:PoseGraph;
  edge:LoopEdge;
  // Appended (1.6): new fields go last so earlier encodings stay readable.
  global_descriptor:GlobalDescriptor;
  match_request:MatchRequest;
  feature_response:FeatureResponse;
  // Appended (3.2): a standalone ACK.
  ack:Ack;
}

root_type Envelope;
