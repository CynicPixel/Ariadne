// Ariadne wire schema (arch §4.1-4.4, §15.2, §15.5, §15.7).
//
// This file is the SINGLE definition of what crosses the network. Generated
// headers are produced by flatc at build time and are never committed, so the
// schema cannot drift from the code that uses it.
//
// Sizing intent from §15.7, which the byte-accounting tests assert against:
//   Pose            7 x f32                      = 28 B
//   SE(3) pose edge 7 x f32 + 21 x f32 + ids     ~ 150 B
//   Pose-graph node                              ~ 28 B

namespace ariadne.wire;

/// §4.4. Values are pinned: the wire format depends on them, so reordering
/// this enum is a breaking protocol change.
enum MessageClass : ubyte {
  HEARTBEAT = 0,
  GLOBAL_DESCRIPTOR = 1,
  LOCAL_DESCRIPTOR = 2,
  MATCH_REQUEST = 3,
  MATCH_RESPONSE = 4,
  POSE_EDGE = 5,
  POSE_GRAPH = 6,
  SUBMAP_SUMMARY = 7,
  SUBMAP_PATCH = 8,
  TASK_BID = 9,
  TASK_CONSENSUS = 10,
  HUMAN_REQUEST = 11,
  ACK = 12
}

enum EdgeStatus : ubyte {
  CANDIDATE = 0,
  GEOMETRY_VERIFIED = 1,
  DEGENERATE = 2,
  PCM_REJECTED = 3,
  GNC_INLIER = 4,
  GNC_OUTLIER = 5,
  /// Appended (3.2): an intra-agent odometry edge inside a POSE_GRAPH snapshot.
  ODOMETRY = 6
}

struct Quaternion { w:float; x:float; y:float; z:float; }
struct Translation { x:float; y:float; z:float; }

/// SE(3) only. C2: a wire schema cannot contain "Sim3 or SE3"; stereo makes
/// scale observable per agent, so inter-agent edges are SE(3). Sim(3) exists
/// only in the monocular ablation and in offline Umeyama alignment, neither of
/// which crosses this serializer.
struct Pose { q:Quaternion; t:Translation; }

/// §15.5 reference-frame algebra. Every pose is frame-tagged and the
/// deserializer REJECTS untagged poses, because a pose whose frame is unknown
/// cannot be composed with anything.
struct FrameTag { agent:uint; epoch:uint; }

/// collaboration.md §4: a broker solve's identity. `counter` = 1 + max over the
/// members' last accepted counters, so a merge is newer than both sides; the
/// full triple (not the counter alone) identifies an estimate.
struct Epoch { counter:ulong; members_hash:ulong; broker:uint; }

/// collaboration.md §3.2: transport acks name transport message ids. `done` lists
/// messages completed (or re-received whole) since the receiver's last ack;
/// `partial` carries a fragment bitmap (bit i = fragment i received) for a
/// message still being reassembled, so only missing fragments are resent.
table PartialAck { msg_id:uint; received:[ubyte]; }
table Ack { done:[uint]; partial:[PartialAck]; }

/// T_G_W for one agent in a broker estimate: G is the estimate's frame
/// (PoseGraph.anchor), W the agent's odometry frame.
table AgentFrame { agent:uint; T_G_W:Pose; }

table PoseNode {
  agent:uint;
  keyframe:ulong;
  stamp_ns:long;
  pose:Pose;
  frame:FrameTag;
}

/// §4.3.
table LoopEdge {
  agent_a:uint;
  keyframe_a:ulong;
  agent_b:uint;
  keyframe_b:ulong;
  measurement:Pose;
  /// Upper triangle of the 6x6 information matrix, row-major: 21 floats.
  information:[float];
  frame_a:FrameTag;
  frame_b:FrameTag;
  status:EdgeStatus;
  inlier_count:uint;
  retrieval_score:float;
  pcm_score:float;
  gnc_weight:float;
  degeneracy_flag:bool;
}

table PoseGraph {
  nodes:[PoseNode];
  edges:[LoopEdge];
  anchor:FrameTag;
  // Appended (3.2): set only on a broker estimate.
  epoch:Epoch;
  agent_frames:[AgentFrame];
}

table Heartbeat {
  agent:uint;
  stamp_ns:long;
  pose:Pose;
  frame:FrameTag;
  battery:float;
  link_state:float;
  keyframe_watermark:ulong;
  // Appended (3.2, collaboration.md §4).
  neighbors:[uint];
  anchor:uint;
  broker:uint;
  epoch:Epoch;
  ack:Ack;
}

/// §21.7 / D115: one CBBA consensus message (Choi, Brunet & How 2009, Table I inputs): per task the sender's winning
/// bid y and winner z (-1 = none), its timestamps s per agent (eq. 5), and the auction's common scales (frozen per
/// allocation event). Class TASK_CONSENSUS; never compressed (§15.7 compresses classes 4-5 only). Count-only in
/// production (the oracle row); the broker SGA consensus on the wire is TaskConsensus below (D175).
table CbbaConsensus {
  tasks:[ulong];
  y:[double];   // double: CBBA compares bids exactly (Table I), so the wire must not round them (D115a)
  z:[byte];
  s:[long];
  scales:[float];
}

/// Every message on the wire is an Envelope. One root type means one
/// serialization boundary, which is what makes byte accounting honest.
/// §15.2 global descriptor (1.6 placeholder: mean-pooled ORB bits, 256 floats).
table GlobalDescriptor {
  keyframe_id:ulong;
  stamp_ns:long;
  descriptor:[float];
  quality:float;
  // 3.4 (D170), appended: the size of this keyframe's feature response, so the broker can price a request before
  // sending it. 0 = not advertised (Phase 1 / v1 senders; FlatBuffers omits default-valued fields, so v1 bytes are
  // unchanged).
  n_features:uint;
  feature_bytes:ushort;   // descriptor bytes per feature (ORB 32)
  // D171, appended: the descriptor as IEEE fp16 bits (arch §15.7's encoding); then `descriptor` is absent. v1 senders
  // never set it, so their bytes are unchanged.
  descriptor_f16:[ushort];
}

/// §15.2 candidate request: the broker asks for one keyframe's local features.
table MatchRequest {
  request_id:ulong;
  query_keyframe:ulong;       // the requester's keyframe
  candidate_keyframe:ulong;   // the receiver's keyframe whose features are wanted
  feature_type:ubyte;         // 0 = ORB-256
}

/// §15.2 feature response: keypoints (x,y pairs), descriptors (32 B each), the
/// sender's 3D points in its rectified-left camera frame (x,y,z triples, NaN =
/// no depth), and camera metadata (fx, fy, cx, cy, baseline_m).
table FeatureResponse {
  request_id:ulong;
  keyframe_id:ulong;
  keypoints:[float];
  descriptors:[ubyte];
  points3d:[float];
  camera:[float];
  // D171, appended: descriptor bytes per feature (0 = ORB's 32, the v1 layout) and a per-response header before them
  // (the int8 encoding's 4-byte scale). v1 senders never set them, so their bytes are unchanged.
  feature_bytes:ushort;
  header_bytes:ushort;
}

/// D175 (live-runtime.md#multi-agent-pipeline): coordination through the radio. Mirrors the planning::multi structs field for field.
/// One 32 x 32 block of the briefing grid (0.05 m): 1024 cell codes (0 unknown, 1 occupied, 2 free not
/// rho_responder-passable, 3 free and passable), packed 4 per byte (cell i in bits 2*(i%4)..+1 of byte i/4): 256 B.
table SlabBlock { bx:int; by:int; cells:[ubyte]; }
/// SUBMAP_PATCH (8): the sender's OWN observations only, in its frame W_sender (`frame`), the blocks changed since the
/// version the receiver acknowledged.
table SubmapPatch { sender:int; epoch:uint; version:ulong; t_ns:long; blocks:[SlabBlock]; frame:FrameTag; }
struct BlockGain { bx:short; by:short; w:ubyte; }   // w: the view's full-IG unknown voxels in the block not known to peers, in units of kFootprintUnit = 16 voxels (rounded up, cap 255; 20de9e8)
/// One of the sender's top-M options (everything the broker's auction needs). Goals in G (`TaskBid.frame`).
table BidOption {
  task_key:long; goal_x:double; goal_y:double;
  ig_raw:[float];        // the five raw IG terms (D114)
  path_m:float; cost_bandwidth:float; cost_risk:float; risk:float; source:ubyte;
  // Appended (D175 R1): the view's footprint for the overlap-aware broker: the planner blocks its full-IG rays hit and
  // the unknown voxels hit in each (collected during the existing ray cast), at most 32.
  footprint:[BlockGain];
}
/// TASK_BID (9): to the sender's component broker, once per replan.
table TaskBid { sender:int; epoch:uint; seq:ulong; t_ns:long; lambda_path:float; options:[BidOption]; frame:FrameTag; }
table Assignment { agent:int; task_key:long; goal_x:double; goal_y:double; }
/// TASK_CONSENSUS (10): the broker's exactly-once assignment for its component. Goals in G (`frame`).
table TaskConsensus {
  broker:int; epoch:uint; seq:ulong; t_ns:long; bids_t_ns:long;
  members:[int]; assignments:[Assignment]; frame:FrameTag;
}

table Envelope {
  cls:MessageClass;
  sender:uint;
  receiver:uint;
  stamp_ns:long;
  sequence:ulong;
  heartbeat:Heartbeat;
  pose_graph:PoseGraph;
  edge:LoopEdge;
  // Appended (1.6): new fields go last so earlier encodings stay readable.
  global_descriptor:GlobalDescriptor;
  match_request:MatchRequest;
  feature_response:FeatureResponse;
  // Appended (3.2): a standalone ACK.
  ack:Ack;
  // Appended (D175): coordination messages.
  submap_patch:SubmapPatch;
  task_bid:TaskBid;
  task_consensus:TaskConsensus;
  // Appended (4.4, D115, renamed at the D175 merge): CBBA consensus, count-only. Field ids are positional, so it
  // sits AFTER the D175 fields the protocol tests pin.
  cbba_consensus:CbbaConsensus;
}

root_type Envelope;
